{
  "name": "vellum-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node packages/storage-pg/scripts/setup-test-db.mjs && vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "depcruise": "depcruise packages apps examples --config .dependency-cruiser.cjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.7.0",
    "eslint": "^9.15.0",
    "globals": "^17.0.0",
    "pnpm": "11.18.0",
    "prettier": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
