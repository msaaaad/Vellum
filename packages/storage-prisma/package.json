{
  "name": "@getattestly/storage-prisma",
  "version": "0.1.0",
  "description": "Prisma StoragePort adapter for Attestly.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@getattestly/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@getattestly/storage-pg": "workspace:*",
    "pg": "^8.22.0",
    "@types/pg": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msaaaad/Vellum.git",
    "directory": "packages/storage-prisma"
  },
  "homepage": "https://github.com/msaaaad/Vellum#readme",
  "bugs": {
    "url": "https://github.com/msaaaad/Vellum/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audit-log",
    "tamper-evident",
    "hash-chain",
    "postgres",
    "nestjs"
  ]
}
