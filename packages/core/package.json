{
  "name": "@attestly/core",
  "version": "0.1.0",
  "description": "Framework-agnostic canonicalization, hashing, and verification for Attestly audit chains.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "canonicalize": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msaaaad/Vellum.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/msaaaad/Vellum#readme",
  "bugs": {
    "url": "https://github.com/msaaaad/Vellum/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audit-log",
    "tamper-evident",
    "hash-chain",
    "postgres",
    "nestjs"
  ]
}
