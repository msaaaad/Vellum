{
  "name": "@vellum/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic canonicalization, hashing, and verification for Vellum audit chains.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
