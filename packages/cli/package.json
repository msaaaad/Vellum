{
  "name": "@attestly/cli",
  "version": "0.1.0",
  "description": "attestly CLI: migrate | verify | export | checkpoint.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evidence-pack": {
      "types": "./dist/evidence-pack.d.ts",
      "import": "./dist/evidence-pack.js"
    }
  },
  "bin": {
    "attestly": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@attestly/core": "workspace:*",
    "@attestly/storage-pg": "workspace:*",
    "pdfkit": "^0.15.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msaaaad/Vellum.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/msaaaad/Vellum#readme",
  "bugs": {
    "url": "https://github.com/msaaaad/Vellum/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audit-log",
    "tamper-evident",
    "hash-chain",
    "postgres",
    "nestjs"
  ]
}
