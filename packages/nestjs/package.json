{
  "name": "@attestly/nestjs",
  "version": "0.1.0",
  "description": "NestJS integration for Attestly: AuditModule, @Audited(), context, and writers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@attestly/core": "workspace:*",
    "@attestly/storage-pg": "workspace:*",
    "pg": "^8.22.0",
    "@attestly/storage-prisma": "workspace:*"
  },
  "peerDependencies": {
    "bullmq": "^5.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msaaaad/Vellum.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/msaaaad/Vellum#readme",
  "bugs": {
    "url": "https://github.com/msaaaad/Vellum/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audit-log",
    "tamper-evident",
    "hash-chain",
    "postgres",
    "nestjs"
  ]
}
