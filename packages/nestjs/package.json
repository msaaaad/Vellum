{
  "name": "@vellum/nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS integration for Vellum: AuditModule, @Audited(), interceptor, and writers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vellum/core": "workspace:*",
    "@vellum/storage-pg": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "peerDependencies": {
    "bullmq": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
